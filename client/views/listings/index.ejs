<% layout('layouts/boilerplate.ejs') %>

    <style>
        /* Local filters for the index page if needed */
        .filter-bar {
            display: flex;
            align-items: center;
            overflow-x: auto;
            padding: 1rem 0;
            margin-bottom: 2rem;
            gap: 2rem;
        }

        .filter-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            opacity: 0.7;
            cursor: pointer;
            transition: opacity 0.2s;
            min-width: 60px;
        }

        .filter-item:hover {
            opacity: 1;
            border-bottom: 2px solid #000;
        }

        .filter-item i {
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
        }

        .filter-item p {
            font-size: 0.8rem;
            font-weight: 500;
            margin: 0;
        }
    </style>

    <!-- Optional: Add a category filter bar here later -->

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 mt-3">
        <% for(let listing of allListings){ %>
            <a href="/listings/<%=listing._id%>" class="listing-link">
                <div class="card listing-card">
                    <div class="card-img-wrapper">
                        <img src="<%=listing.image%>" class="card-img-top" alt="Listing Image">
                        <div class="card-img-overlay"></div>
                    </div>

                    <div class="card-body">
                        <p class="card-text">
                            <span class="fw-bold">
                                <%=listing.title%>
                            </span> <br>
                            <span class="text-muted">
                                <%=listing.location%>, <%=listing.country%>
                            </span> <br>
                            <span class="price-tag">&#8377; <%=listing.price.toLocaleString("en-IN")%> / night</span>
                        </p>
                    </div>
                </div>
            </a>
            <% } %>
    </div>